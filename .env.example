# =============================================================================
# Tefnut — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
# =============================================================================

# ---------------------------------------------------------------------------
# Authentication (REQUIRED)
# ---------------------------------------------------------------------------
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_at_least_32_char_secret_here

# ---------------------------------------------------------------------------
# Database (REQUIRED for production)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://tefnut_app:PASSWORD@YOUR_RDS_HOST:5432/tefnut

# Development fallback org ID (used when no JWT is present in dev mode)
DEV_ORG_ID=

# ---------------------------------------------------------------------------
# Python Engine Lambda URLs (REQUIRED for production)
# Leave empty to use the local subprocess fallback (development only)
# ---------------------------------------------------------------------------
LAMBDA_CARBON_URL=https://YOUR_API_GATEWAY_ID.execute-api.eu-west-1.amazonaws.com/prod
LAMBDA_WATER_URL=https://YOUR_API_GATEWAY_ID.execute-api.eu-west-1.amazonaws.com/prod

# ---------------------------------------------------------------------------
# AWS S3 Storage
# ---------------------------------------------------------------------------
AWS_REGION=eu-west-1
S3_BUCKET_NAME=tefnut-data
KMS_KEY_ID=arn:aws:kms:eu-west-1:ACCOUNT_ID:key/KEY_ID

# In production, use IAM instance profile — omit these:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------------
# Base URL for API calls from the browser (leave empty for same-origin)
VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# Node environment
# ---------------------------------------------------------------------------
NODE_ENV=development
